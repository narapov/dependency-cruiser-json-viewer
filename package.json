{
  "name": "dependency-cruiser-json-viewer",
  "description": "Interactive browser viewer for dependency-cruiser JSON cruise results — explore file trees, dependency graphs, and module relations.",
  "keywords": [
    "dependency-cruiser",
    "depcruise",
    "dependency-graph",
    "visualization",
    "dependency-visualization"
  ],
  "license": "MIT",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narapov/dependency-cruiser-json-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/narapov/dependency-cruiser-json-viewer/issues"
  },
  "homepage": "https://github.com/narapov/dependency-cruiser-json-viewer#readme",
  "type": "module",
  "bin": {
    "dependency-cruiser-json-viewer": "bin/dependency-cruiser-json-viewer.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ts && vite build",
    "build:gh-pages": "npm run build:ts && vite build --base=/dependency-cruiser-json-viewer/ && npm run depcruise:json-for-gh-pages",
    "build:ts": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "depcruise:json": "depcruise src -T json -f ./cruise-result.json",
    "depcruise:json-for-gh-pages": "depcruise src -T json -f dist/cruise-result.json",
    "depcruise:json-for-cli": "depcruise src -T json -f test-data/cruise-result.json",
    "cli:verify": "npm run build && npm run depcruise:json-for-cli && node bin/dependency-cruiser-json-viewer.mjs test-data/cruise-result.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "release:ci": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@baybreezy/file-extension-icon": "^0.0.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-tree-view": "^9.10.1",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.19.0",
    "elkjs": "^0.12.0",
    "fuzzysort": "^3.1.0",
    "i18next": "^26.3.6",
    "picomatch": "^4.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-use": "^17.6.1",
    "serve-handler": "^6.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prettier/plugin-oxc": "^0.1.4",
    "@release-it/conventional-changelog": "^12.0.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "release-it": "^21.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}

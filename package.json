{
  "name": "dependency-cruiser-json-viewer",
  "description": "Interactive browser viewer for dependency-cruiser JSON cruise results — explore file trees, dependency graphs, and module relations.",
  "keywords": [
    "dependency-cruiser",
    "depcruise",
    "dependency-graph",
    "dependency-viewer",
    "visualization",
    "dependency-visualization",
    "architecture",
    "dependency-analysis",
    "circular",
    "circular-dependencies",
    "module-dependencies",
    "codebase-exploration"
  ],
  "author": "Nikolay Arapov <arapov.nv@gmail.com>",
  "license": "MIT",
  "version": "1.10.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narapov/dependency-cruiser-json-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/narapov/dependency-cruiser-json-viewer/issues"
  },
  "homepage": "https://github.com/narapov/dependency-cruiser-json-viewer#readme",
  "type": "module",
  "bin": {
    "dependency-cruiser-json-viewer": "bin/dependency-cruiser-json-viewer.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ts && vite build",
    "build:gh-pages": "npm run build:ts && vite build --base=/dependency-cruiser-json-viewer/ && npm run depcruise:json-for-gh-pages",
    "build:ts": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "depcruise:json": "depcruise src -m -T json -f ./cruise-result.json",
    "depcruise:json-for-gh-pages": "depcruise src invalid_samples -c .dependency-cruiser.sample.ts -m -T json -f dist/cruise-result.json",
    "depcruise:json-for-cli": "depcruise src invalid_samples -c .dependency-cruiser.sample.ts -m -T json -f test-data/cruise-result.json",
    "watch-src-and-regenerate-cruise-result-for-cli": "node scripts/watchSrcAndRegenerateCruiseResultForCli.ts",
    "cli:verify": "npm run build && npm run depcruise:json-for-cli && node bin/dependency-cruiser-json-viewer.mjs test-data/cruise-result.json",
    "cli:verify:workspace-settings": "npm run build && npm run depcruise:json-for-cli && node bin/dependency-cruiser-json-viewer.mjs test-data/cruise-result.json --workspace-settings test-data/workspace-settings.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "release:ci": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "serve-handler": "^6.1.7",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@baybreezy/file-extension-icon": "^0.0.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mr_mint/elkjs-libavoid": "^0.5.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-tree-view": "^9.17.0",
    "@prettier/plugin-oxc": "^0.1.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-color": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.21.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.1",
    "dependency-cruiser": "^18.7.2",
    "elkjs": "^0.12.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fuzzysort": "^3.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "i18next": "^26.7.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-json-view-lite": "^2.5.0",
    "react-resizable-panels": "^4.18.1",
    "react-use": "^17.6.1",
    "release-it": "^21.1.2",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.6.7",
    "zustand": "^5.0.16",
    "zustand-computed": "^2.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
